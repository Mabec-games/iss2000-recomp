 void recomp::start(const recomp::Configuration& cfg) {
+    // This host application may return to its launcher and start another game session after a
+    // netplay timeout. Reset the process-wide run state before creating the new runtime threads.
+    exited.store(false);
+    game_status.store(GameStatus::None);
     project_version = cfg.project_version;
 
     recomp::check_all_stored_roms();
